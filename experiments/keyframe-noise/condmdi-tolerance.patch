index 9746c7d..ad60d2e 100644
--- a/model/rotation2xyz.py
+++ b/model/rotation2xyz.py
@@ -12,7 +12,40 @@ class Rotation2xyz:
     def __init__(self, device, dataset='amass'):
         self.device = device
         self.dataset = dataset
-        self.smpl_model = SMPL().eval().to(device)
+        self._smpl_model = None
+        self._pending_apply = []
+        self._pending_train = None
+
+    @property
+    def smpl_model(self):
+        # Built on first use rather than at construction. SMPL_NEUTRAL.pkl is a
+        # chumpy pickle, and chumpy does not import on Python >=3.11 / numpy >=1.24.
+        # Nothing on the hml_vec sampling path touches SMPL -- it is only needed
+        # to produce meshes -- so deferring keeps sampling runnable while still
+        # failing loudly for anything that genuinely needs the body model.
+        if self._smpl_model is None:
+            m = SMPL().eval().to(self.device)
+            # replay the .to()/.train() calls the parent module made meanwhile,
+            # so a deferred build lands in the same state an eager one would
+            for fn in self._pending_apply:
+                m._apply(fn)
+            if self._pending_train is not None:
+                m.train(*self._pending_train[0], **self._pending_train[1])
+            self._smpl_model = m
+        return self._smpl_model
+
+    def defer_apply(self, fn):
+        """_apply for the SMPL submodule, queued if it has not been built yet."""
+        if self._smpl_model is None:
+            self._pending_apply.append(fn)
+        else:
+            self._smpl_model._apply(fn)
+
+    def defer_train(self, *args, **kwargs):
+        if self._smpl_model is None:
+            self._pending_train = (args, kwargs)
+        else:
+            self._smpl_model.train(*args, **kwargs)
 
